}

set_custom_dpi() {
    D="$1"; check_expiry || return 1
    case "$D" in ''|*[!0-9]*) echo "Invalid DPI."; return 1 ;; esac
    [ "$D" -ge 100 ] && [ "$D" -le 1000 ] || { echo "Allowed DPI: 100-1000"; return 1; }
    create_backup || return 1
    wm density "$D" >/dev/null 2>&1
    if wm density 2>/dev/null | grep -q "Override density: $D"; then
        success "DPI set to $D"; log_message "Custom DPI $D"; return 0
    fi
    failed "DPI change"; return 1
}

resolution_status() {
    header "SCREEN RESOLUTION & DENSITY STATUS"
    wm size 2>/dev/null
    echo ""; wm density 2>/dev/null
}

set_resolution() {
    R="$1"; check_expiry || return 1
    case "$R" in *x*) ;; *) echo "Format: WIDTHxHEIGHT"; return 1 ;; esac
    W="${R%x*}"; H="${R#*x}"
    case "$W$H" in ''|*[!0-9]*) echo "Invalid resolution."; return 1 ;; esac
    [ "$W" -ge 320 ] && [ "$W" -le 10000 ] || { echo "Width out of range."; return 1; }
    [ "$H" -ge 320 ] && [ "$H" -le 10000 ] || { echo "Height out of range."; return 1; }
    save_display_backups
    header "SCREEN RESOLUTION"
    echo "Target: ${W}x${H}"
    wm size "${W}x${H}" >/dev/null 2>&1
    if wm size 2>/dev/null | grep -q "Override size: ${W}x${H}"; then
        success "Resolution applied"; log_message "Resolution ${W}x${H}"; return 0
    fi
    failed "Resolution change"; return 1
}

reset_resolution() {
    header "RESET SCREEN RESOLUTION & DENSITY"
    wm size reset >/dev/null 2>&1
    wm density reset >/dev/null 2>&1
    rm -f "$RES_BACKUP" "$DPI_BACKUP" 2>/dev/null
    echo "Physical resolution & default density requested."
    wm size 2>/dev/null
    log_message "Resolution and density reset"
}

restore_resolution() {
    header "RESTORE ORIGINAL RESOLUTION"
    if [ ! -f "$RES_BACKUP" ]; then echo "Resolution backup not found."; return 1; fi
    ORIGINAL="$(sed -n 's/.*Override size: //p' "$RES_BACKUP" | head -n 1)"
    if [ -n "$ORIGINAL" ]; then wm size "$ORIGINAL" >/dev/null 2>&1
    else wm size reset >/dev/null 2>&1; fi
    echo "Original resolution restore requested."
    wm size 2>/dev/null
    log_message "Original resolution restored"
}

set_downscale() {
    P="$1"; check_expiry || return 1
    case "$P" in ''|*[!0-9]*) echo "Invalid percentage."; return 1 ;; esac
    [ "$P" -ge 70 ] && [ "$P" -le 100 ] || { echo "Allowed range: 70-100%"; return 1; }
    PHYSICAL="$(wm size 2>/dev/null | sed -n 's/.*Physical size: //p' | head -n 1)"
    PHYS_DPI="$(wm density 2>/dev/null | sed -n 's/.*Physical density: //p' | head -n 1)"
    [ -n "$PHYSICAL" ] || { echo "Cannot detect physical resolution."; return 1; }
    W="${PHYSICAL%x*}"; H="${PHYSICAL#*x}"
    save_display_backups
    NEW_RES="$(awk -v w="$W" -v h="$H" -v p="$P" 'BEGIN {nw=int(w*p/100/2)*2; nh=int(h*p/100/2)*2; printf "%dx%d",nw,nh}')"
    header "PROPORTIONAL SCREEN DOWNSCALE"
    echo "Physical: $PHYSICAL | Scale: ${P}% | Target: $NEW_RES"
    if set_resolution "$NEW_RES"; then
        if [ -n "$PHYS_DPI" ]; then
            NEW_DPI="$(awk -v d="$PHYS_DPI" -v p="$P" 'BEGIN {nd=int(d*p/100); if(nd<120) nd=120; printf "%d",nd}')"
            wm density "$NEW_DPI" >/dev/null 2>&1
            echo "Proportional DPI adjusted: ${PHYS_DPI} -> ${NEW_DPI}"
        fi
        return 0
    fi
    return 1
}

