APP_NAME="REOSHERLY GRAPHICS VVIP"
VERSION="5.2-symphine"
DEVELOPER="ReoSherly"
TIKTOK="@symphine_elyra"
EXPIRY_DATE="2026-11-28"

TARGET_DPI=430
ANIMATION_SCALE=0.5
BASE="/data/local/tmp/reosherly_vvip"
BACKUP="$BASE/backup"
LOG="$BASE/activity.log"
INSTALL_DATE="$BASE/install_date"
DPI_BACKUP="$BASE/density_backup"
RES_BACKUP="$BASE/resolution_backup"

mkdir -p "$BASE" 2>/dev/null
SUCCESS=0
FAILED=0
UNSUPPORTED=0

line() { echo "===================================================="; }
header() { echo ""; line; echo "       $1"; line; }
have_cmd() { command -v "$1" >/dev/null 2>&1; }
log_message() { printf '[%s] %s\n' "$(date '+%F %T' 2>/dev/null)" "$*" >> "$LOG" 2>/dev/null; }
notify() {
    if have_cmd cmd; then
        cmd notification post -S bigtext -t "REOSHERLY VVIP" "symphine" "$1" >/dev/null 2>&1
    fi
}
success() { echo "[SUCCESS] $1"; }
failed() { echo "[FAILED] $1"; }
unsupported() { echo "[SKIPPED] $1"; }
warn() { echo "[WARNING] $1"; }

is_root() {
    [ "$(id -u 2>/dev/null)" = "0" ]
}

check_expiry() {
    TODAY="$(date '+%Y%m%d' 2>/dev/null)"
    EXPIRY="$(echo "$EXPIRY_DATE" | tr -d '-')"
    case "$TODAY" in ''|*[!0-9]*) echo "Tanggal sistem tidak valid."; return 1 ;; esac
    case "$EXPIRY" in ''|*[!0-9]*) echo "Tanggal expiry tidak valid."; return 1 ;; esac
    if [ "$TODAY" -gt "$EXPIRY" ]; then
        header "LICENSE EXPIRED"
        echo "Expired: $EXPIRY_DATE"
        return 1
    fi
    return 0
}

# -------------------- DEVICE & BACKEND INFORMATION --------------------
device_info() {
    header "DEVICE INFORMATION"
    echo "Brand        : $(getprop ro.product.brand)"
    echo "Manufacturer : $(getprop ro.product.manufacturer)"
    echo "Model        : $(getprop ro.product.model)"
    echo "Device       : $(getprop ro.product.device)"
    echo "Android      : $(getprop ro.build.version.release)"
    echo "SDK          : $(getprop ro.build.version.sdk)"
    echo "Build        : $(getprop ro.build.display.id)"
    echo "Architecture : $(uname -m 2>/dev/null)"
    echo "CPU ABI      : $(getprop ro.product.cpu.abi)"
    echo "Kernel       : $(uname -r 2>/dev/null)"
    echo "CPU Cores    : $(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
    if is_root; then echo "Privilege    : ROOT (UID 0)"; else echo "Privilege    : ADB / SHIZUKU SHELL (UID $(id -u 2>/dev/null))"; fi
    grep -E 'MemTotal|MemAvailable|MemFree' /proc/meminfo 2>/dev/null
}

display_info() {
    header "DISPLAY INFORMATION"
    echo "Size:"; wm size 2>/dev/null
    echo "Density:"; wm density 2>/dev/null
    echo "OpenGL: $(getprop ro.opengles.version)"
    echo "EGL: $(getprop ro.hardware.egl)"
    echo "HWUI Renderer: $(getprop debug.hwui.renderer)"
    dumpsys display 2>/dev/null | grep -m 12 -E 'supportedModes|refreshRate|DisplayDeviceInfo'
}

cpu_info() {
    header "CPU INFORMATION"
    echo "Architecture: $(uname -m 2>/dev/null)"
    echo "Cores: $(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
    grep -m 8 -E 'Hardware|model name|Processor|CPU architecture' /proc/cpuinfo 2>/dev/null
    FREQ="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)"
    GOV="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)"
    [ -n "$FREQ" ] && echo "CPU0 Frequency: ${FREQ} kHz" || echo "CPU0 Frequency: Restricted by SELinux"
    [ -n "$GOV" ] && echo "CPU0 Governor : $GOV" || echo "CPU0 Governor : Restricted by SELinux"
}

angle_status() {
    header "ANGLE & GRAPHICS BACKEND STATUS"
    echo "Packages : $(settings get global angle_gl_driver_selection_pkgs 2>/dev/null)"
    echo "Drivers  : $(settings get global angle_gl_driver_selection_values 2>/dev/null)"
    echo "Feature  : $(getprop debug.angle.feature_overrides_enabled 2>/dev/null)"
    if pm list packages 2>/dev/null | grep -q 'angle'; then
        echo "ANGLE Pkg: Installed ($(pm list packages 2>/dev/null | grep 'angle' | head -n 1))"
    else
        echo "ANGLE Pkg: System built-in or not exposed as separate APK"
    fi
    echo "Catatan  : Pemilihan driver bergantung pada dukungan GPU & ROM."
}

gpu_info() {
    header "GPU INFORMATION"
    echo "EGL    : $(getprop ro.hardware.egl)"
    echo "Vulkan : $(getprop ro.hardware.vulkan)"
    echo "OpenGL : $(getprop ro.opengles.version)"
    getprop 2>/dev/null | grep -iE 'gpu|egl|vulkan|adreno|mali' | head -n 20
    angle_status
}

battery_info() {
    header "BATTERY INFORMATION"
    echo "Capacity: $(cat /sys/class/power_supply/battery/capacity 2>/dev/null) %"
    echo "Status: $(cat /sys/class/power_supply/battery/status 2>/dev/null)"
    TEMP="$(cat /sys/class/power_supply/battery/temp 2>/dev/null)"
    case "$TEMP" in ''|*[!0-9]*) echo "Temperature: Unavailable" ;; *) awk -v t="$TEMP" 'BEGIN {printf "Temperature: %.1f C\n",t/10}' ;; esac
    echo "Voltage (microvolt): $(cat /sys/class/power_supply/battery/voltage_now 2>/dev/null)"
}

performance_monitor() {
    header "PERFORMANCE MONITOR"
    echo "Uptime:"; uptime 2>/dev/null
    echo "Load:"; cat /proc/loadavg 2>/dev/null
    echo "RAM:"; grep -E 'MemTotal|MemAvailable|MemFree|Cached' /proc/meminfo 2>/dev/null
    echo "Battery: $(cat /sys/class/power_supply/battery/capacity 2>/dev/null)%"
    TEMP="$(cat /sys/class/power_supply/battery/temp 2>/dev/null)"
    case "$TEMP" in ''|*[!0-9]*) echo "Battery temp: Unavailable" ;; *) awk -v t="$TEMP" 'BEGIN {printf "Battery temp: %.1f C\n",t/10}' ;; esac
    echo "Thermal service (read-only):"
    dumpsys thermalservice 2>/dev/null | head -n 20
}

network_info() {
    header "NETWORK INFORMATION"
    echo "IP:"; ip addr show 2>/dev/null | grep 'inet '
    echo "DNS1: $(getprop net.dns1)"; echo "DNS2: $(getprop net.dns2)"
    dumpsys connectivity 2>/dev/null | grep -E 'CONNECTED|VALIDATED' | head -n 10
    if have_cmd ping; then ping -c 1 -W 2 1.1.1.1 2>/dev/null | tail -n 2; fi
}

storage_manager() {
    header "STORAGE MANAGER"
    df -h /data 2>/dev/null
    echo "Script storage:"; du -sh "$BASE" 2>/dev/null
    echo "Files:"; find "$BASE" -type f 2>/dev/null
}

device_check() {
    header "UNIFIED DEVICE CHECK — V5.2"
    device_info; cpu_info; gpu_info; display_info
    battery_info; performance_monitor; network_info; storage_manager
    header "INSTALLED GAME CHECK"
    for P in com.dts.freefireth com.dts.freefiremax; do
        if pm path "$P" 2>/dev/null | grep -q 'package:'; then
            VER="$(dumpsys package "$P" 2>/dev/null | awk -F= '/versionName/{print $2; exit}')"
            echo "$P : INSTALLED (v${VER:-unknown})"
        else
            echo "$P : NOT INSTALLED"
        fi
    done
    log_message "Unified device check"
}

# -------------------- ATOMIC BACKUP / RESTORE --------------------
save_display_backups() {
    if have_cmd wm; then
        if [ ! -f "$DPI_BACKUP" ]; then
            wm density 2>/dev/null > "$DPI_BACKUP.tmp" && mv "$DPI_BACKUP.tmp" "$DPI_BACKUP"
        fi
        if [ ! -f "$RES_BACKUP" ]; then
            wm size 2>/dev/null > "$RES_BACKUP.tmp" && mv "$RES_BACKUP.tmp" "$RES_BACKUP"
        fi
    fi
}

backup_get() {
    [ -f "$BACKUP" ] || return 1
    awk -F'|' -v n="$1" -v k="$2" '$1==n && $2==k {sub(/^[^|]*\|[^|]*\|/,""); print; exit}' "$BACKUP" 2>/dev/null
}

backup_setting() {
    NS="$1"; KEY="$2"
    VALUE="$(settings get "$NS" "$KEY" 2>/dev/null)"
    [ -n "$VALUE" ] || VALUE="null"
    printf '%s|%s|%s\n' "$NS" "$KEY" "$VALUE" >> "$TEMP"
}

create_backup() {
    header "CREATE BACKUP"
    save_display_backups
    if [ -f "$BACKUP" ]; then
        echo "Backup lama tersedia; tidak ditimpa."
        return 0
    fi
    TEMP="$BACKUP.tmp"; : > "$TEMP" || return 1
    for KEY in angle_gl_driver_selection_pkgs angle_gl_driver_selection_values app_standby_enabled app_restriction_enabled background_check_enabled low_power cached_apps_freezer peak_refresh_rate min_refresh_rate window_animation_scale transition_animation_scale animator_duration_scale; do
        case "$KEY" in peak_refresh_rate|min_refresh_rate) NS="system" ;; *) NS="global" ;; esac
        backup_setting "$NS" "$KEY"
    done
    VALUE="$(getprop debug.angle.feature_overrides_enabled 2>/dev/null)"
    [ -n "$VALUE" ] || VALUE="null"
    printf 'PROP|debug.angle.feature_overrides_enabled|%s\n' "$VALUE" >> "$TEMP"
    if mv "$TEMP" "$BACKUP"; then
        success "Backup created"
        log_message "Backup created"
        return 0
    fi
    rm -f "$TEMP"; failed "Backup creation"; return 1
}

restore_key() {
    NS="$1"; KEY="$2"; VALUE="$(backup_get "$NS" "$KEY")"
    if ! grep -Fq "$NS|$KEY|" "$BACKUP" 2>/dev/null; then return 0; fi
    if [ "$VALUE" = "null" ]; then
        settings delete "$NS" "$KEY" >/dev/null 2>&1
    else
        settings put "$NS" "$KEY" "$VALUE" >/dev/null 2>&1
    fi
    CURRENT="$(settings get "$NS" "$KEY" 2>/dev/null)"
    if [ "$VALUE" = "null" ] && { [ -z "$CURRENT" ] || [ "$CURRENT" = "null" ]; }; then
        success "Restored $KEY"; return 0
    fi
    if [ "$CURRENT" = "$VALUE" ]; then
        success "Restored $KEY"; return 0
    fi
    failed "Restore $KEY"; return 1
}

restore_default() {
    header "RESTORE ALL BACKUP SETTINGS"
    FAIL=0
    if [ -f "$BACKUP" ]; then
        for ITEM in \
            "global angle_gl_driver_selection_pkgs" \
            "global angle_gl_driver_selection_values" \
            "global app_standby_enabled" \
            "global app_restriction_enabled" \
            "global background_check_enabled" \
            "global low_power" \
            "global cached_apps_freezer" \
            "system peak_refresh_rate" \
            "system min_refresh_rate" \
            "global window_animation_scale" \
            "global transition_animation_scale" \
            "global animator_duration_scale"; do
            set -- $ITEM; restore_key "$1" "$2" || FAIL=1
        done
        PROP_VAL="$(backup_get PROP debug.angle.feature_overrides_enabled)"
        if grep -Fq 'PROP|debug.angle.feature_overrides_enabled|' "$BACKUP"; then
            if [ "$PROP_VAL" = "null" ]; then
                unsupported "Properti ANGLE kosong (tidak perlu diubah)"
            elif have_cmd setprop && is_root; then
                setprop debug.angle.feature_overrides_enabled "$PROP_VAL" >/dev/null 2>&1
                [ "$(getprop debug.angle.feature_overrides_enabled)" = "$PROP_VAL" ] && success "Restored ANGLE property" || { failed "ANGLE property"; FAIL=1; }
            else
                unsupported "setprop (butuh akses root untuk properti debug.*)"
            fi
        fi
    else
        warn "Settings backup file not found; skipping settings restore."
    fi

    if [ -f "$RES_BACKUP" ] && have_cmd wm; then
        ORIGINAL_RES="$(sed -n 's/.*Override size: //p' "$RES_BACKUP" | head -n 1)"
        if [ -n "$ORIGINAL_RES" ]; then
            wm size "$ORIGINAL_RES" >/dev/null 2>&1
        else
            wm size reset >/dev/null 2>&1
        fi
        success "Resolution restored to original state"
    fi

    if [ -f "$DPI_BACKUP" ] && have_cmd wm; then
        ORIGINAL_DPI="$(sed -n 's/.*Override density: //p' "$DPI_BACKUP" | head -n 1)"
        if [ -n "$ORIGINAL_DPI" ]; then
            wm density "$ORIGINAL_DPI" >/dev/null 2>&1
        else
            wm density reset >/dev/null 2>&1
        fi
        success "DPI restored to original state"
    fi

    if [ "$FAIL" -eq 0 ]; then
        success "Full restore completed"
        log_message "Full restore completed"
        notify "Restore completed"
        return 0
    fi
    failed "Some settings could not be restored"; return 1
}

apply_setting() {
    NS="$1"; KEY="$2"; VALUE="$3"; LABEL="$4"
    if ! have_cmd settings; then unsupported "$LABEL"; UNSUPPORTED=$((UNSUPPORTED+1)); return 1; fi
    settings put "$NS" "$KEY" "$VALUE" >/dev/null 2>&1
    CURRENT="$(settings get "$NS" "$KEY" 2>/dev/null)"
    if [ "$CURRENT" = "$VALUE" ]; then
        [ -n "$LABEL" ] && success "$LABEL"
        SUCCESS=$((SUCCESS+1))
        return 0
    fi
    [ -n "$LABEL" ] && failed "$LABEL"
    FAILED=$((FAILED+1))
    return 1
}

