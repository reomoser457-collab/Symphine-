}

apply_dpi() {
    check_expiry || return 1; header "DISPLAY DENSITY"; create_backup || return 1
    if ! have_cmd wm; then unsupported "wm command"; return 1; fi
    wm density "$TARGET_DPI" >/dev/null 2>&1
