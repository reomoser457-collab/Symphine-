    apply_setting global app_standby_enabled 1 "App Standby flag"
    apply_setting global app_restriction_enabled 0 "App Restriction flag"
    apply_setting global background_check_enabled 0 "Background Check flag"
    apply_setting global low_power 0 "Battery Saver disabled"
    apply_setting global cached_apps_freezer enabled "Cached Apps Freezer enabled"
    line; echo "SUCCESS: $SUCCESS | FAILED: $FAILED | UNSUPPORTED: $UNSUPPORTED"; line
    echo "Catatan: key ini bergantung ROM dan bukan jaminan peningkatan FPS."
    log_message "Background optimizer executed"
}

select_game() {
    case "$1" in
        ff|freefire) PACKAGE="com.dts.freefireth"; GAME_NAME="Free Fire" ;;
        ffmax|max|freefiremax) PACKAGE="com.dts.freefiremax"; GAME_NAME="Free Fire MAX" ;;
        *) echo "Invalid game. Use ff / ffmax."; return 1 ;;
    esac
    if pm path "$PACKAGE" 2>/dev/null | grep -q 'package:'; then
        echo "Game detected: $GAME_NAME ($PACKAGE)"
    else
        warn "$GAME_NAME is not installed."
    fi
    return 0
}

validate_lod() {
    case "$1" in 1|2|3|4) LOD="$1" ;; *) echo "LOD must be 1-4."; return 1 ;; esac
}

apply_angle() {
    check_expiry || return 1
    GAME_ARG="$1"; GRAPHICS="$2"; LOD_ARG="$3"
    select_game "$GAME_ARG" || return 1; validate_lod "$LOD_ARG" || return 1
    case "$GRAPHICS" in
        smooth) FEATURES="disableAnisotropicFiltering:forceTextureLodOffset$LOD" ;;
        pixel) FEATURES="forceNearestFiltering:disableAnisotropicFiltering:forceTextureLodOffset$LOD" ;;
        *) echo "Graphics must be smooth or pixel."; return 1 ;;
    esac
    header "SYMPHINE ANGLE GRAPHICS"
    echo "Game: $GAME_NAME | Graphics: $GRAPHICS | LOD: $LOD"
    create_backup || return 1
    apply_setting global angle_gl_driver_selection_pkgs "$PACKAGE" "ANGLE target package"; A=$?
    apply_setting global angle_gl_driver_selection_values angle "ANGLE driver mode"; B=$?
    
    C=1
    if have_cmd setprop; then
        setprop debug.angle.feature_overrides_enabled "$FEATURES" >/dev/null 2>&1
        if [ "$(getprop debug.angle.feature_overrides_enabled)" = "$FEATURES" ]; then
            success "ANGLE feature property ($FEATURES)"
            C=0
        else
            warn "ANGLE feature property skipped (membutuhkan Root / SELinux permissive)"
        fi
    fi

    if have_cmd am; then
        am force-stop "$PACKAGE" >/dev/null 2>&1
        echo "Game process restarted cleanly."
    fi
    log_message "ANGLE $GAME_NAME $GRAPHICS LOD $LOD"
    notify "$GAME_NAME - $GRAPHICS"
    # Sukses jika Settings API (Shizuku/Brevent standard) berhasil diterapkan
    [ "$A" -eq 0 ] && [ "$B" -eq 0 ]
}

compile_game() {
    check_expiry || return 1
    GAME_ARG="$1"
    MODE="${2:-speed-profile}"
    select_game "$GAME_ARG" || return 1
    case "$MODE" in speed-profile|speed|everything) ;; *) echo "Mode: speed-profile / speed / everything"; return 1 ;; esac
    if ! pm path "$PACKAGE" 2>/dev/null | grep -q 'package:'; then
        failed "$GAME_NAME tidak terinstal di perangkat ini."
        return 1
    fi
    header "ART BYTECODE COMPILER"
    echo "Target : $GAME_NAME ($PACKAGE)"
    echo "Filter : $MODE (Proses ini memakan waktu 10-45 detik...)"
    if cmd package compile -m "$MODE" -f "$PACKAGE" 2>&1; then
        success "Kompilasi ART ($MODE) selesai untuk $GAME_NAME"
        log_message "Compiled $PACKAGE with $MODE"
        notify "$GAME_NAME compiled ($MODE)"
        return 0
    else
        failed "Kompilasi ART ditolak oleh sistem"
        return 1
    fi
}

set_refresh() {
    check_expiry || return 1; HZ="$1"
    case "$HZ" in 60|90|120|144) ;; *) echo "Choose 60 / 90 / 120 / 144."; return 1 ;; esac
    header "REFRESH RATE"; echo "Target: ${HZ}Hz (panel harus mendukung mode ini)."
    create_backup || return 1
    apply_setting system peak_refresh_rate "$HZ" "Peak refresh rate"; A=$?
    apply_setting system min_refresh_rate "$HZ" "Minimum refresh rate"; B=$?
    echo "Peak: $(settings get system peak_refresh_rate) | Min: $(settings get system min_refresh_rate)"
    log_message "Refresh rate $HZ"; notify "Refresh rate $HZ Hz"
    [ "$A" -eq 0 ] && [ "$B" -eq 0 ]
}

set_custom_refresh() {
    check_expiry || return 1; HZ="$1"
    case "$HZ" in ''|*[!0-9.]*) echo "Invalid Hz."; return 1 ;; esac
    awk -v n="$HZ" 'BEGIN {exit !(n>=30 && n<=240)}' || { echo "Range: 30-240 Hz."; return 1; }
    create_backup || return 1; header "CUSTOM REFRESH RATE"
    apply_setting system peak_refresh_rate "$HZ" "Peak refresh rate"; A=$?
    apply_setting system min_refresh_rate "$HZ" "Minimum refresh rate"; B=$?
    log_message "Custom refresh $HZ"; [ "$A" -eq 0 ] && [ "$B" -eq 0 ]
}

reset_refresh() {
    header "RESET REFRESH RATE"
    settings delete system peak_refresh_rate >/dev/null 2>&1
    settings delete system min_refresh_rate >/dev/null 2>&1
    echo "Reset requested; ROM default behavior will apply."
    log_message "Refresh reset"
}

refresh_status() {
    header "REFRESH RATE STATUS"
    echo "Peak: $(settings get system peak_refresh_rate)"
    echo "Min : $(settings get system min_refresh_rate)"
    dumpsys display 2>/dev/null | grep -m 12 -E 'DisplayDeviceInfo|supportedModes|refreshRate'
}

set_animation() {
    check_expiry || return 1; SPEED="$1"
    case "$SPEED" in 0|0.0|0.25|0.5|0.75|1|1.0) ;; *) echo "Choose 0 / 0.25 / 0.5 / 0.75 / 1."; return 1 ;; esac
